{
  "name": "paper-armada",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,party -c blue,magenta \"next dev\" \"npm:party\"",
    "next": "next dev",
    "party": "wrangler dev --port 1999 --ip 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy:party": "wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "next": "^14.2.35",
    "partyserver": "^0.5.10",
    "partysocket": "^1.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.152.0"
  }
}
