# Host of the deployed relay Worker (no protocol, no trailing slash).
# Local dev defaults to <page-host>:1999, so you only need this in production.
# After `npm run deploy:party`, set this to the host it prints, e.g.:
# NEXT_PUBLIC_PARTYKIT_HOST=paper-armada.your-subdomain.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=
